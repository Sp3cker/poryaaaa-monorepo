spacing = _{ " " | "\t" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }
voice_group_name = @{ ident_char+ }
label_name = @{ ident_char+ }
start_slot = @{ ASCII_DIGIT+ }

comment = { "@" ~ (!("\n" | "\r") ~ ANY)* }
directive = { "." ~ (!"@" ~ ANY)+ }
voice_group_declaration = { "voice_group" ~ spacing+ ~ voice_group_name ~ (spacing* ~ "," ~ spacing* ~ start_slot)? }
assembly_label = { label_name ~ "::" }

macro_name = @{ (!("voice_group" ~ (spacing | EOI | ",")) ~ "voice_" ~ ident_char+) | "cry" ~ ("_" ~ ident_char+)* }
argument_value = @{ (!("," | "@" | spacing) ~ ANY)+ }
argument = { spacing* ~ argument_value? ~ spacing* }
argument_list = { argument ~ ("," ~ argument)* }
macro_call = { macro_name ~ (spacing+ ~ argument_list)? }

source_code = { directive | voice_group_declaration | assembly_label | macro_call }
source_line = { SOI ~ spacing* ~ source_code? ~ spacing* ~ comment? ~ spacing* ~ EOI }

invalid_voice_group_code = @{ "voice_group" ~ (spacing | "," | EOI) ~ (!"@" ~ ANY)* }
invalid_voice_group_line = { SOI ~ spacing* ~ invalid_voice_group_code ~ spacing* ~ comment? ~ spacing* ~ EOI }
invalid_code = @{ (!"@" ~ ANY)+ }
invalid_source_line = { SOI ~ spacing* ~ invalid_code ~ spacing* ~ comment? ~ spacing* ~ EOI }
