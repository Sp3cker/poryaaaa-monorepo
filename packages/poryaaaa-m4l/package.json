{
  "name": "poryaaaa-m4l",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript sources live in code-src/; esbuild bundles them to javascript/ for Max [v8] and [node.script].",
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "build": "run-s --silent build:js build:externals install:max-package",
    "build:js": "run-s --silent build:v8 build:node",
    "build:v8": "run-s --silent check:v8 bundle:v8",
    "build:node": "run-s --silent build:napi check:node bundle:node",
    "build:napi": "npm --prefix ../voicegroup-core-node run build",
    "bundle:v8": "esbuild code-src/ccomidi_voices.ts code-src/recorder/ccomidi_recorder.ts --bundle --outdir=javascript --entry-names=[name] --format=iife --platform=neutral --target=es2020 --log-level=warning",
    "bundle:node": "esbuild code-src/poryaaaa_voicegroup_server.ts code-src/ccomidi_voicegroup_client.ts code-src/cleanup.ts --bundle --outdir=javascript --format=cjs --platform=node --target=node24 --external:max-api --external:@poryaaaa/voicegroup-core-node --log-level=warning",
    "build:voicegroup-core-static": "bash scripts/build_voicegroup_core_static.sh",
    "build:externals": "run-s --silent build:voicegroup-core-static build:externals:cmake",
    "build:externals:cmake": "cmake -G Xcode -B build --log-level=WARNING && cmake --build build --config Release -- -quiet",
    "install:max-package": "scripts/install_max_package.sh",
    "probe:recorder-size": "tsx code-src/tools/recorder-midi-size-probe.ts",
    "watch": "run-p watch:v8 watch:node",
    "watch:v8": "esbuild code-src/ccomidi_voices.ts code-src/recorder/ccomidi_recorder.ts --bundle --outdir=javascript --entry-names=[name] --format=iife --platform=neutral --target=es2020 --watch",
    "watch:node": "esbuild code-src/poryaaaa_voicegroup_server.ts code-src/ccomidi_voicegroup_client.ts code-src/cleanup.ts --bundle --outdir=javascript --format=cjs --platform=node --target=node24 --external:max-api --external:@poryaaaa/voicegroup-core-node --watch",
    "check": "run-s --silent check:v8 check:node check:test",
    "check:v8": "tsc -p code-src/tsconfig.v8.json --noEmit",
    "check:node": "tsc -p code-src/tsconfig.node.json --noEmit",
    "check:test": "tsc -p code-src/tsconfig.test.json --noEmit",
    "pretest": "npm run build:napi",
    "test": "node --no-deprecation --test-timeout=5000 --import tsx --import ./code-src/test/setup.ts --test code-src/test/*.test.ts"
  },
  "devDependencies": {
    "@types/maxmsp": "^1.0.15",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@poryaaaa/voicegroup-core-node": "file:../voicegroup-core-node",
    "midi-writer-js": "^3.2.1",
    "ws": "^8.21.0"
  }
}
