{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poryaaaa.pcm-mixer-cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "cases"],
  "properties": {
    "schema": {"type": "string", "const": "poryaaaa.pcm-mixer-cases"},
    "version": {"type": "integer", "const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "source", "settings"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "mode": {"type": "string", "enum": ["ipatix", "sappy"]},
          "source": {"type": "string", "pattern": "^inputs/[^/]+\\.s$"},
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pcm_rate_hz", "max_channels", "master_volume", "voice_volume", "reverb"],
            "properties": {
              "pcm_rate_hz": {"type": "integer", "minimum": 1, "maximum": 1000000},
              "max_channels": {"type": "integer", "minimum": 0, "maximum": 15},
              "master_volume": {"type": "integer", "minimum": 0, "maximum": 15},
              "voice_volume": {"type": "integer", "minimum": 0, "maximum": 127},
              "reverb": {"type": "integer", "minimum": 0, "maximum": 127}
            }
          }
        }
      }
    }
  }
}
