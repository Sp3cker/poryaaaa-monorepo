+static void _observeTimer(struct GBAAudio* audio, int fifoId, uint32_t cyclesLate) {
+	const struct GBAAudioObservationSink* sink = audio->observationSink;
+	if (!sink) {
+		return;
+	}
+
+	uint64_t cycle = mTimingGlobalTime(&audio->p->timing);
+	if (cyclesLate > cycle) {
+		cycle = 0;
+	} else {
+		cycle -= cyclesLate;
+	}
+	struct GBAAudioObservation observation;
+	observation.cycle = cycle;
+	observation.kind = GBA_AUDIO_OBSERVATION_TIMER;
+	observation.width = 0;
+	observation.address = GBA_BASE_IO | (fifoId ? GBA_REG_FIFO_B_LO : GBA_REG_FIFO_A_LO);
+	observation.value = fifoId ? audio->chBTimer : audio->chATimer;
+	observation.cyclesLate = cyclesLate;
+	observation.left = 0;
+	observation.right = 0;
+	sink->emit(sink->context, &observation);
+}
+
+static void _observeSample(struct GBAAudio* audio, int32_t timestamp, int16_t left, int16_t right) {
+	const struct GBAAudioObservationSink* sink = audio->observationSink;
+	if (!sink) {
+		return;
+	}
+
+	uint64_t observationCycle = mTimingGlobalTime(&audio->p->timing);
+	int64_t cycle =
+	    (int64_t) observationCycle + ((int64_t) timestamp - (int64_t) mTimingCurrentTime(&audio->p->timing));
+	if (cycle < 0 || (uint64_t) cycle > observationCycle) {
+		return;
+	}
+
+	struct GBAAudioObservation observation;
+	observation.cycle = (uint64_t) cycle;
+	observation.kind = GBA_AUDIO_OBSERVATION_SAMPLE;
+	observation.width = 0;
+	observation.address = 0;
+	observation.value = 0;
+	observation.cyclesLate = (uint32_t) (observationCycle - (uint64_t) cycle);
+	observation.left = left;
+	observation.right = right;
+	sink->emit(sink->context, &observation);
+}
+
+void GBAAudioSetObservationSink(struct GBAAudio* audio, const struct GBAAudioObservationSink* sink) {
+	audio->observationSink = sink;
+}
+
+void GBAAudioObserveWrite(struct GBAAudio* audio, uint32_t address, uint8_t width, uint32_t value) {
+	const struct GBAAudioObservationSink* sink = audio->observationSink;
