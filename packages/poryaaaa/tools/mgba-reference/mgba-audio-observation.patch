+	observation.cycle = mTimingGlobalTime(&audio->p->timing);
+	observation.kind = GBA_AUDIO_OBSERVATION_WRITE;
+	observation.width = width;
+	observation.address = address;
+	observation.value = value;
+	observation.cyclesLate = 0;
+	observation.left = 0;
+	observation.right = 0;
+	sink->emit(sink->context, &observation);
+}
