{
    "configurations": [
        {
            "type": "extensionHost",
            "request": "launch",
            "name": "Debug Voicegroup LSP VS Code Extension",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder:poryaaaa-monorepo}/packages/voicegroup-lsp/vscode-extension",
                "${workspaceFolder:poryaaaa-monorepo}"
            ],
            "preLaunchTask": "Build voicegroup-lsp VS Code extension"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug poryaaaa-rs in clap-host",
            "program": "${workspaceFolder:poryaaaa-monorepo}/../clap-host/builds/ninja-system/host/Debug/clap-host",
            "args": [
                "-p",
                "${workspaceFolder:poryaaaa-monorepo}/packages/poryaaaa/plugin/target/debug/poryaaaa-rs.clap"
            ],
            "cwd": "${workspaceFolder:poryaaaa-monorepo}/../clap-host/builds/ninja-system/host/Debug",
            "preLaunchTask": "Build poryaaaa-rs CLAP debug bundle"
        }
    ]
}
